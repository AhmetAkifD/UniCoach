# Yerel geliştirme için kopyalayın: cp .env.example apps/api/.env
# Docker Compose bu değerlerin kendi varsayılanlarını kullanır, .env gerekmez.

# API (apps/api)
DATABASE_URL=postgresql://unicoach:unicoach@localhost:5432/unicoach?schema=public
API_PORT=4000
WEB_ORIGIN=http://localhost:3000,http://localhost:8081
JWT_SECRET=degistir-beni-uzun-rastgele-bir-deger
# Soru Bankası PDF'lerinin dizini (göreli yol API dizinine göredir)
UPLOAD_DIR=storage

# Web (apps/web)
API_INTERNAL_URL=http://localhost:4000
