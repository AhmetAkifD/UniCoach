// UniCoach veri modeli.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  ADMIN
}

/// Öğrencinin hazırlandığı sınav. YKS = TYT + AYT (+ YDT).
enum ExamTrack {
  YKS
  LGS
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  firstName    String
  lastName     String
  passwordHash String
  role         UserRole   @default(STUDENT)
  /// Kayıtta seçilir; eski hesaplarda boş olabilir.
  examTrack    ExamTrack?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  sources      Source[]
  books        QuestionBook[]
  exams        Exam[]
  yksResults   YksResult[]
  preferences  Preference[]
  notebooks    Notebook[]
}

enum SourceKind {
  VIDEO
  PLAYLIST
}

/// Konu Anlatımı: öğrencinin eklediği bir YouTube videosu veya oynatma listesi ("kaynak grubu").
/// Yalnızca ekleyen öğrenciye görünür.
model Source {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// packages/shared → SUBJECTS kimliği (ör. "ayt-fizik")
  subject      String
  kind         SourceKind
  /// Video ID'si ya da oynatma listesi ID'si
  youtubeId    String
  /// Öğrencinin değiştirebildiği grup adı; başta YouTube başlığıdır.
  title        String
  author       String?
  thumbnailUrl String?
  /// Liste YouTube oynatıcısının 200 video sınırına takılmış olabilir.
  truncated    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  items        SourceItem[]

  @@unique([userId, kind, youtubeId])
  @@index([userId, subject])
}

/// Kaynaktaki tek video. Aynı video bir listede birden çok kez geçebilir; bu yüzden sıra numarasıyla ayrılır.
/// Kaynak kişiye özel olduğundan izleme ilerlemesi de burada tutulur.
model SourceItem {
  id          String    @id @default(cuid())
  sourceId    String
  source      Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  /// YouTube'daki sıra (0'dan başlar)
  position    Int
  videoId     String
  title       String
  durationSec Int?
  /// Kalınan yer (saniye)
  positionSec Int       @default(0)
  watchedAt   DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([sourceId, position])
}

/// Soru Bankası: öğrencinin yüklediği soru kitabı PDF'i. Dosya diskte (UPLOAD_DIR/books/<id>.pdf) durur.
/// Yalnızca yükleyen öğrenciye görünür.
model QuestionBook {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// packages/shared → SUBJECTS kimliği
  subject    String
  /// Başta dosya adıdır; öğrenci değiştirebilir.
  title      String
  /// Serbest konu etiketi (isteğe bağlı)
  topic      String?
  sizeBytes  Int
  /// PDF ilk kez açılınca görüntüleyici bildirir.
  pageCount  Int?
  /// Kalınan sayfa (1'den başlar)
  lastPage   Int       @default(1)
  /// Soru çıkarma ayarları (öğrenci seçer): "auto" | "text" | "ocr"
  detectMethod String    @default("auto")
  /// Cevap anahtarının yeri: "auto" | "lastPages" | "pageBottom" | "none"
  keyMethod    String    @default("auto")
  /// Dosya tamamen yüklenince dolar; boşsa kayıt listede görünmez.
  uploadedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  questions  BookQuestion[]
  exams      Exam[]

  @@index([userId, subject])
}

/// PDF'ten çıkarılmış soru: metni değil, sayfadaki yeri (PDF noktası, sol üstten) ve cevabı saklanır.
model BookQuestion {
  id          String       @id @default(cuid())
  bookId      String
  book        QuestionBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  /// Test/bölüm adı; numara bölüm içinde tekildir.
  section     String
  number      Int
  page        Int
  x           Float
  y           Float
  w           Float
  h           Float
  choiceCount Int          @default(5)
  /// "A"–"E"; bilinmiyorsa boş
  answer      String?
  /// Şık metinleri (öneri; metin katmanı ya da OCR)
  choices     String[]
  /// Kaydedilme sırası (PDF'teki sıra)
  position    Int
  examQuestions ExamQuestion[]

  /// Bir testte aynı numara olmaz; kural API'de (zod) denetlenir. Kayıtta kimlikler korunduğu için
  /// numaraların yer değiştirmesi ara adımda çakışmasın diye veritabanında tekil kısıt yoktur.
  @@index([bookId, section, number])
  @@index([bookId, position])
}

/// Geçmiş Sınavlar: Soru Bankası'ndan seçilen testlerle kurulan süreli deneme.
model Exam {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId      String
  book        QuestionBook   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  /// Seçilen testlerin adları
  title       String
  /// Net kuralı: YKS'de 4, LGS'de 3 yanlış bir doğruyu götürür.
  track       ExamTrack
  /// Boşsa süresiz
  durationSec Int?
  /// Sonradan eklenen süre (saniye)
  extraSec    Int            @default(0)
  /// Duraklatıldıysa duraklatma anı; süre işlemez
  pausedAt    DateTime?
  /// Önceki duraklatmaların toplamı (ms); bitiş anı bu kadar ötelenir
  pausedMs    Int            @default(0)
  startedAt   DateTime       @default(now())
  finishedAt  DateTime?
  correct     Int?
  wrong       Int?
  blank       Int?
  net         Float?
  questions   ExamQuestion[]

  @@index([userId, startedAt])
}

/// Sınavdaki soru: kaynak sorunun o anki kopyası (yer + doğru cevap) ve öğrencinin cevabı.
model ExamQuestion {
  id             String        @id @default(cuid())
  examId         String
  exam           Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  position       Int
  /// Kaynağa dönüp düzeltmek için; kaynak silinirse boşalır.
  bookQuestionId String?
  bookQuestion   BookQuestion? @relation(fields: [bookQuestionId], references: [id], onDelete: SetNull)
  section        String
  number         Int
  page           Int
  x              Float
  y              Float
  w              Float
  h              Float
  choiceCount    Int
  correctAnswer  String
  answer         String?
  answeredAt     DateTime?

  @@unique([examId, position])
}

/// YKS Tercih: öğrencinin bir yılın YKS sonucu. Belgeden okunur ya da elle girilir; kimlik bilgisi saklanmaz.
model YksResult {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year         Int
  /// "document" | "manual"
  source       String
  diplomaGrade Float?
  obp          Float?
  /// packages/shared → YksScore[] (puan türü, puan, başarı sırası, yerleştirme ve ek puanlı değerler)
  scores       Json
  /// packages/shared → YksTest[] (oturum, test adı, doğru, yanlış)
  tests        Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userId, year])
}

/// YKS Tercih: YÖK Atlas tercih kılavuzundan indirilen program. Her indirmede tablo baştan yazılır.
model Program {
  /// ÖSYM program kodu (kılavuz kodu)
  code            Int      @id
  /// Taban puan ve sıranın yılı
  year            Int
  universityId    Int
  universityName  String
  /// DEVLET | VAKIF | KKTC | YURTDISI
  universityType  String
  /// Yurt dışı programlarda boş
  cityCode        Int?
  cityName        String?
  faculty         String?
  name            String
  /// Yeni açılan bazı programlarda boş
  groupId         Int?
  groupName       String
  /// LISANS | ONLISANS
  level           String
  /// TYT | SAY | SOZ | EA | DIL
  scoreType       String
  language        String?
  educationTypeId Int?
  educationType   String?
  /// 0: devlet (ücretsiz)
  scholarshipId   Int
  scholarship     String?
  durationYears   Int?
  quota           Int?
  minScore        Float?
  rank            Int?
  /// packages/shared → ProgramHistory[] (önceki üç yıl)
  history         Json
  minRankRequired Int?
  fee             Int?
  /// ProgramCondition kodları (kılavuzdaki koşul maddeleri)
  conditions      Int[]

  @@index([scoreType, rank])
  @@index([universityId])
  @@index([groupId])
  @@index([cityCode])
}

/// Tercih kılavuzunun koşul maddeleri (programlarda yalnızca numarası tutulur).
model ProgramCondition {
  code Int    @id
  text String
}

/// YÖK Atlas indirme kayıtları; en sonuncusu indirilmiş verinin durumudur.
model ProgramSync {
  id         Int      @id @default(autoincrement())
  year       Int
  count      Int
  finishedAt DateTime @default(now())
}

/// YKS Tercih listesi: öğrencinin seçtiği programlar, öncelik sırasıyla (en fazla 24).
model Preference {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ÖSYM program kodu; indirilmiş veride olmayabilir (canlı aramadan eklenmiş olabilir)
  programCode Int
  /// 1'den başlar
  position    Int
  /// Eklendiği andaki program (packages/shared → ProgramSummary); indirilmiş veride yoksa bu gösterilir
  snapshot    Json
  addedAt     DateTime @default(now())

  @@unique([userId, programCode])
  @@index([userId, position])
}

/// Çalışma alanı: öğrencinin not defteri. Yalnızca sahibine görünür.
model Notebook {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime       @default(now())
  /// Bir sayfası kaydedilince de güncellenir (listede son çalışılan defter üstte).
  updatedAt DateTime       @updatedAt
  pages     NotebookPage[]

  @@index([userId, updatedAt])
}

/// Defter sayfası: kalem/marker çizgileri ve metin kutuları (packages/shared → NotePageContent).
model NotebookPage {
  id         String   @id @default(cuid())
  notebookId String
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  /// 1'den başlar, boşluksuz
  position   Int
  content    Json
  updatedAt  DateTime @updatedAt

  @@index([notebookId, position])
}
